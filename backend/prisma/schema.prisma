generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                    @id @default(uuid()) @db.Char(36)
  fullName                  String                    @map("full_name") @db.VarChar(255)
  email                     String                    @unique(map: "email") @db.VarChar(255)
  phone                     String?                   @db.VarChar(50)
  passwordHash              String                    @map("password_hash") @db.VarChar(255)
  createdAt                 DateTime                  @default(now()) @map("created_at")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  status                    UserStatus                @default(ACTIVE)
  auditLogs                 AuditLog[]
  uploadedDocuments         Document[]
  receivedGrns              GoodsReceivedNote[]       @relation("GrnReceivedBy")
  inventoryTransactions     InventoryTransaction[]
  inspections               MaterialInspection[]      @relation("Inspector")
  materialIssuesApproved    MaterialIssue[]           @relation("IssueApprovedBy")
  materialIssuesReceived    MaterialIssue[]           @relation("IssueReceiver")
  materialIssuesRequested   MaterialIssue[]           @relation("IssueRequestedBy")
  requestApprovals          MaterialRequestApproval[]
  requestedMaterialRequests MaterialRequest[]         @relation("RequestedBy")
  materialReturnsReceived   MaterialReturn[]          @relation("ReturnReceivedBy")
  materialReturnsReturned   MaterialReturn[]          @relation("ReturnReturnedBy")
  wastageApproved           MaterialWastage[]         @relation("WastageApprovedBy")
  wastageReported           MaterialWastage[]         @relation("WastageReportedBy")
  notifications             Notification[]
  managedProjects           Project[]                 @relation("ProjectManager")
  createdPurchaseOrders     PurchaseOrder[]           @relation("PurchaseOrderCreatedBy")
  stockAdjustmentsApproved  StockAdjustment[]         @relation("AdjustmentApprovedBy")
  stockAdjustmentsRequested StockAdjustment[]         @relation("AdjustmentRequestedBy")
  stockCountsPerformed      StockCount[]              @relation("StockCountedBy")
  stockCountsVerified       StockCount[]              @relation("StockVerifiedBy")
  createdQuarantines        MaterialQuarantine[]      @relation("QuarantineCreatedBy")
  dispositionsPerformed     MaterialDisposition[]     @relation("DispositionPerformedBy")

  warehousesResponsibleFor Warehouse[] @relation("WarehouseResponsibleUser")
  roles                    UserRole[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Char(36)
  name        String           @unique(map: "name") @db.VarChar(100)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  name        String           @unique(map: "name") @db.VarChar(150)
  description String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Char(36)
  roleId String @map("role_id") @db.Char(36)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_fkey")
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_fkey")
  @@map("role_permissions")
}

model Project {
  id                    String                 @id @default(uuid()) @db.Char(36)
  projectCode           String                 @unique(map: "project_code") @map("project_code") @db.VarChar(50)
  name                  String                 @db.VarChar(255)
  location              String?                @db.VarChar(255)
  clientName            String?                @map("client_name") @db.VarChar(255)
  contractorName        String?                @map("contractor_name") @db.VarChar(255)
  consultantName        String?                @map("consultant_name") @db.VarChar(255)
  projectManagerId      String?                @map("project_manager_id") @db.Char(36)
  startDate             DateTime?              @map("start_date") @db.Date
  completionDate        DateTime?              @map("completion_date") @db.Date
  contractValue         Decimal?               @map("contract_value") @db.Decimal(18, 2)
  currency              String                 @default("ETB") @db.VarChar(10)
  status                ProjectStatus          @default(ACTIVE)
  description           String?                @db.Text
  imageUrl              String?                @map("image_url") @db.Text
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  activities            Activity[]
  buildings             Building[]
  documents             Document[]
  goodsReceivedNotes    GoodsReceivedNote[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  materialConsumption   MaterialConsumption[]
  materialIssues        MaterialIssue[]
  materialRequests      MaterialRequest[]
  materialReturns       MaterialReturn[]
  materialWastage       MaterialWastage[]
  projectManager        User?                  @relation("ProjectManager", fields: [projectManagerId], references: [id])
  purchaseOrders        PurchaseOrder[]
  stockAdjustments      StockAdjustment[]
  stockCounts           StockCount[]
  Warehouse             Warehouse[]
  zones                 Zone[]
  quarantines           MaterialQuarantine[]

  @@index([status])
  @@index([projectManagerId], map: "projects_project_manager_id_fkey")
  @@map("projects")
}

model Building {
  id               String                @id @default(uuid()) @db.Char(36)
  projectId        String                @map("project_id") @db.Char(36)
  code             String                @db.VarChar(50)
  name             String                @db.VarChar(255)
  description      String?               @db.Text
  createdAt        DateTime              @default(now()) @map("created_at")
  activities       Activity[]
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consumption      MaterialConsumption[]
  materialIssues   MaterialIssue[]
  materialRequests MaterialRequest[]
  wastage          MaterialWastage[]
  zones            Zone[]

  @@unique([projectId, code], map: "uq_building_project_code")
  @@index([projectId])
  @@map("buildings")
}

model Zone {
  id               String                @id @default(uuid()) @db.Char(36)
  projectId        String                @map("project_id") @db.Char(36)
  buildingId       String?               @map("building_id") @db.Char(36)
  code             String?               @db.VarChar(50)
  name             String                @db.VarChar(255)
  description      String?               @db.Text
  createdAt        DateTime              @default(now()) @map("created_at")
  activities       Activity[]
  consumption      MaterialConsumption[]
  materialIssues   MaterialIssue[]
  materialRequests MaterialRequest[]
  building         Building?             @relation(fields: [buildingId], references: [id])
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([buildingId], map: "zones_building_id_fkey")
  @@index([projectId], map: "zones_project_id_fkey")
  @@map("zones")
}

model Activity {
  id               String                @id @default(uuid()) @db.Char(36)
  projectId        String                @map("project_id") @db.Char(36)
  buildingId       String?               @map("building_id") @db.Char(36)
  zoneId           String?               @map("zone_id") @db.Char(36)
  code             String?               @db.VarChar(50)
  name             String                @db.VarChar(255)
  description      String?               @db.Text
  status           ActivityStatus        @default(NOT_STARTED)
  createdAt        DateTime              @default(now()) @map("created_at")
  building         Building?             @relation(fields: [buildingId], references: [id])
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  zone             Zone?                 @relation(fields: [zoneId], references: [id])
  consumption      MaterialConsumption[]
  materialIssues   MaterialIssue[]
  materialRequests MaterialRequest[]
  wastage          MaterialWastage[]

  @@index([buildingId], map: "activities_building_id_fkey")
  @@index([projectId], map: "activities_project_id_fkey")
  @@index([zoneId], map: "activities_zone_id_fkey")
  @@map("activities")
}

model MaterialCategory {
  id          String     @id @default(uuid()) @db.Char(36)
  name        String     @unique(map: "name") @db.VarChar(100)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  materials   Material[]

  @@map("material_categories")
}

model Unit {
  id          String               @id @default(uuid()) @db.Char(36)
  code        String               @unique(map: "code") @db.VarChar(20)
  name        String               @db.VarChar(100)
  symbol      String               @db.VarChar(20)
  createdAt   DateTime             @default(now()) @map("created_at")
  grnItems    GrnItem[]
  materials   Material[]
  quarantines MaterialQuarantine[]

  @@map("units")
}

model Material {
  id                    String                 @id @default(uuid()) @db.Char(36)
  materialCode          String                 @unique(map: "material_code") @map("material_code") @db.VarChar(50)
  name                  String                 @db.VarChar(255)
  categoryId            String                 @map("category_id") @db.Char(36)
  unitId                String                 @map("unit_id") @db.Char(36)
  specification         String?                @db.Text
  standard              String?                @db.VarChar(100)
  description           String?                @db.Text
  estimatedUnitPrice    Decimal                @default(0.00) @map("estimated_unit_price") @db.Decimal(18, 2)
  currentUnitPrice      Decimal                @default(0.00) @map("current_unit_price") @db.Decimal(18, 2)
  minimumStock          Decimal                @default(0.000) @map("minimum_stock") @db.Decimal(18, 3)
  reorderLevel          Decimal                @default(0.000) @map("reorder_level") @db.Decimal(18, 3)
  maximumStock          Decimal?               @map("maximum_stock") @db.Decimal(18, 3)
  requiresInspection    Boolean                @default(true) @map("requires_inspection")
  requiresCertificate   Boolean                @default(false) @map("requires_certificate")
  storageRequirements   String?                @map("storage_requirements") @db.Text
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  grnItems              GrnItem[]
  inspectionItems       InspectionItem[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  consumption           MaterialConsumption[]
  issueItems            MaterialIssueItem[]
  requestItems          MaterialRequestItem[]
  returnItems           MaterialReturnItem[]
  suppliers             MaterialSupplier[]
  wastage               MaterialWastage[]
  category              MaterialCategory       @relation(fields: [categoryId], references: [id])
  unit                  Unit                   @relation(fields: [unitId], references: [id])
  purchaseOrderItems    PurchaseOrderItem[]
  stockCountItems       StockCountItem[]
  quarantines           MaterialQuarantine[]
  StockAdjustmentItem   StockAdjustmentItem[]

  @@index([isActive])
  @@index([categoryId], map: "idx_materials_category")
  @@index([unitId], map: "idx_materials_unit")
  @@map("materials")
}

model Supplier {
  id                 String              @id @default(uuid()) @db.Char(36)
  supplierCode       String              @unique(map: "supplier_code") @map("supplier_code") @db.VarChar(50)
  companyName        String              @map("company_name") @db.VarChar(255)
  contactPerson      String?             @map("contact_person") @db.VarChar(255)
  phone              String?             @db.VarChar(50)
  email              String?             @db.VarChar(255)
  address            String?             @db.Text
  registrationNumber String?             @map("registration_number") @db.VarChar(100)
  taxNumber          String?             @map("tax_number") @db.VarChar(100)
  licenseNumber      String?             @map("license_number") @db.VarChar(100)
  rating             Decimal?            @db.Decimal(3, 2)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  goodsReceived      GoodsReceivedNote[]
  materials          MaterialSupplier[]
  purchaseOrders     PurchaseOrder[]

  @@index([isActive])
  @@map("suppliers")
}

model MaterialSupplier {
  materialId        String   @map("material_id") @db.Char(36)
  supplierId        String   @map("supplier_id") @db.Char(36)
  preferred         Boolean  @default(false)
  supplierUnitPrice Decimal? @map("supplier_unit_price") @db.Decimal(18, 2)
  leadTimeDays      Int?     @map("lead_time_days")
  createdAt         DateTime @default(now()) @map("created_at")
  material          Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([materialId, supplierId])
  @@index([supplierId], map: "material_suppliers_supplier_id_fkey")
  @@map("material_suppliers")
}

model Warehouse {
  id                  String   @id @default(uuid()) @db.Char(36)
  projectId           String   @map("project_id") @db.Char(36)
  code                String   @db.VarChar(50)
  name                String   @db.VarChar(255)
  type                String?  @db.VarChar(50)
  responsibleUserId   String?  @map("responsible_user_id") @db.Char(36)
  capacityDescription String?  @map("capacity_description") @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  responsibleUser User? @relation("WarehouseResponsibleUser", fields: [responsibleUserId], references: [id])

  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  materialIssues        MaterialIssue[]
  stockAdjustments      StockAdjustment[]
  stockCounts           StockCount[]
  storageLocations      StorageLocation[]
  project               Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, code], map: "uq_warehouse_project_code")
  @@index([projectId])
  @@map("warehouses")
}

model StorageLocation {
  id                    String                 @id @default(uuid()) @db.Char(36)
  warehouseId           String                 @map("warehouse_id") @db.Char(36)
  code                  String                 @db.VarChar(50)
  name                  String                 @db.VarChar(255)
  locationType          String?                @map("location_type") @db.VarChar(50)
  capacity              Decimal?               @db.Decimal(18, 3)
  description           String?                @db.Text
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  grnItems              GrnItem[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  issueItems            MaterialIssueItem[]
  stockCountItems       StockCountItem[]
  warehouse             Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code], map: "uq_storage_warehouse_code")
  @@index([warehouseId])
  @@map("storage_locations")
}

model MaterialRequest {
  id             String                    @id @default(uuid()) @db.Char(36)
  requestNumber  String                    @unique(map: "request_number") @map("request_number") @db.VarChar(50)
  projectId      String                    @map("project_id") @db.Char(36)
  requestedBy    String                    @map("requested_by") @db.Char(36)
  buildingId     String?                   @map("building_id") @db.Char(36)
  zoneId         String?                   @map("zone_id") @db.Char(36)
  activityId     String?                   @map("activity_id") @db.Char(36)
  requestDate    DateTime                  @map("request_date") @db.Date
  requiredDate   DateTime?                 @map("required_date") @db.Date
  priority       MaterialRequestPriority   @default(NORMAL)
  purpose        String?                   @db.Text
  status         MaterialRequestStatus     @default(DRAFT)
  remarks        String?                   @db.Text
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  approvals      MaterialRequestApproval[]
  items          MaterialRequestItem[]
  activity       Activity?                 @relation(fields: [activityId], references: [id])
  building       Building?                 @relation(fields: [buildingId], references: [id])
  project        Project                   @relation(fields: [projectId], references: [id])
  requester      User                      @relation("RequestedBy", fields: [requestedBy], references: [id])
  zone           Zone?                     @relation(fields: [zoneId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([requestDate], map: "idx_material_requests_date")
  @@index([projectId], map: "idx_material_requests_project")
  @@index([status], map: "idx_material_requests_status")
  @@index([activityId], map: "material_requests_activity_id_fkey")
  @@index([buildingId], map: "material_requests_building_id_fkey")
  @@index([requestedBy], map: "material_requests_requested_by_fkey")
  @@index([zoneId], map: "material_requests_zone_id_fkey")
  @@map("material_requests")
}

model MaterialRequestItem {
  id                 String          @id @default(uuid()) @db.Char(36)
  requestId          String          @map("request_id") @db.Char(36)
  materialId         String          @map("material_id") @db.Char(36)
  requestedQuantity  Decimal         @map("requested_quantity") @db.Decimal(18, 3)
  approvedQuantity   Decimal         @default(0.000) @map("approved_quantity") @db.Decimal(18, 3)
  suppliedQuantity   Decimal         @default(0.000) @map("supplied_quantity") @db.Decimal(18, 3)
  issuedQuantity     Decimal         @default(0.000) @map("issued_quantity") @db.Decimal(18, 3)
  estimatedUnitPrice Decimal?        @map("estimated_unit_price") @db.Decimal(18, 2)
  remarks            String?         @db.Text
  material           Material        @relation(fields: [materialId], references: [id])
  request            MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([materialId], map: "material_request_items_material_id_fkey")
  @@index([requestId], map: "material_request_items_request_id_fkey")
  @@map("material_request_items")
}

model MaterialRequestApproval {
  id               String          @id @default(uuid()) @db.Char(36)
  requestId        String          @map("request_id") @db.Char(36)
  approverId       String          @map("approver_id") @db.Char(36)
  action           ApprovalAction
  approvedQuantity Decimal?        @map("approved_quantity") @db.Decimal(18, 3)
  comments         String?         @db.Text
  actionDate       DateTime        @default(now()) @map("action_date")
  approver         User            @relation(fields: [approverId], references: [id])
  request          MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([approverId], map: "material_request_approvals_approver_id_fkey")
  @@index([requestId], map: "material_request_approvals_request_id_fkey")
  @@map("material_request_approvals")
}

model PurchaseOrder {
  id         String @id @default(uuid()) @db.Char(36)
  projectId  String @map("project_id") @db.Char(36)
  supplierId String @map("supplier_id") @db.Char(36)

  materialRequestId String? @map("material_request_id") @db.Char(36)

  purchaseOrderNumber  String    @unique(map: "purchase_order_number") @map("purchase_order_number") @db.VarChar(50)
  orderDate            DateTime  @map("order_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date

  status PurchaseOrderStatus @default(DRAFT)

  subtotal    Decimal @default(0.00) @db.Decimal(18, 2)
  taxAmount   Decimal @default(0.00) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount Decimal @default(0.00) @db.Decimal(18, 2)

  currency String  @default("ETB") @db.VarChar(10)
  remarks  String? @db.Text

  createdBy String?  @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")

  goodsReceived GoodsReceivedNote[]
  items         PurchaseOrderItem[]

  creator  User?    @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  materialRequest MaterialRequest? @relation(fields: [materialRequestId], references: [id])

  @@index([status])
  @@index([createdBy], map: "purchase_orders_created_by_fkey")
  @@index([projectId], map: "purchase_orders_project_id_fkey")
  @@index([supplierId], map: "purchase_orders_supplier_id_fkey")
  @@index([materialRequestId], map: "purchase_orders_material_request_id_fkey")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid()) @db.Char(36)
  purchaseOrderId  String        @map("purchase_order_id") @db.Char(36)
  materialId       String        @map("material_id") @db.Char(36)
  orderedQuantity  Decimal       @map("ordered_quantity") @db.Decimal(18, 3)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(18, 2)
  receivedQuantity Decimal       @default(0.000) @map("received_quantity") @db.Decimal(18, 3)
  material         Material      @relation(fields: [materialId], references: [id])
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([materialId], map: "purchase_order_items_material_id_fkey")
  @@index([purchaseOrderId], map: "purchase_order_items_purchase_order_id_fkey")
  @@map("purchase_order_items")
}

model GoodsReceivedNote {
  id                 String               @id @default(uuid()) @db.Char(36)
  grnNumber          String               @unique(map: "grn_number") @map("grn_number") @db.VarChar(50)
  projectId          String               @map("project_id") @db.Char(36)
  supplierId         String               @map("supplier_id") @db.Char(36)
  purchaseOrderId    String?              @map("purchase_order_id") @db.Char(36)
  deliveryDate       DateTime             @map("delivery_date") @db.Date
  deliveryNoteNumber String?              @map("delivery_note_number") @db.VarChar(100)
  vehicleNumber      String?              @map("vehicle_number") @db.VarChar(50)
  driverName         String?              @map("driver_name") @db.VarChar(255)
  status             GrnStatus            @default(DRAFT)
  receivedBy         String?              @map("received_by") @db.Char(36)
  remarks            String?              @db.Text
  createdAt          DateTime             @default(now()) @map("created_at")
  project            Project              @relation(fields: [projectId], references: [id])
  purchaseOrder      PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  receiver           User?                @relation("GrnReceivedBy", fields: [receivedBy], references: [id])
  supplier           Supplier             @relation(fields: [supplierId], references: [id])
  items              GrnItem[]
  inspections        MaterialInspection[]
  quarantines        MaterialQuarantine[]

  @@index([status])
  @@index([purchaseOrderId], map: "goods_received_notes_purchase_order_id_fkey")
  @@index([receivedBy], map: "goods_received_notes_received_by_fkey")
  @@index([deliveryDate], map: "idx_grn_date")
  @@index([projectId], map: "idx_grn_project")
  @@index([supplierId], map: "idx_grn_supplier")
  @@map("goods_received_notes")
}

model GrnItem {
  id                String               @id @default(uuid()) @db.Char(36)
  grnId             String               @map("grn_id") @db.Char(36)
  materialId        String               @map("material_id") @db.Char(36)
  orderedQuantity   Decimal?             @map("ordered_quantity") @db.Decimal(18, 3)
  deliveredQuantity Decimal              @map("delivered_quantity") @db.Decimal(18, 3)
  damagedQuantity   Decimal              @default(0.000) @map("damaged_quantity") @db.Decimal(18, 3)
  rejectedQuantity  Decimal              @default(0.000) @map("rejected_quantity") @db.Decimal(18, 3)
  acceptedQuantity  Decimal              @default(0.000) @map("accepted_quantity") @db.Decimal(18, 3)
  unitId            String               @map("unit_id") @db.Char(36)
  batchNumber       String?              @map("batch_number") @db.VarChar(100)
  manufacturingDate DateTime?            @map("manufacturing_date") @db.Date
  expiryDate        DateTime?            @map("expiry_date") @db.Date
  storageLocationId String?              @map("storage_location_id") @db.Char(36)
  remarks           String?              @db.Text
  grn               GoodsReceivedNote    @relation(fields: [grnId], references: [id], onDelete: Cascade)
  material          Material             @relation(fields: [materialId], references: [id])
  storageLocation   StorageLocation?     @relation(fields: [storageLocationId], references: [id])
  unit              Unit                 @relation(fields: [unitId], references: [id])
  inspectionItems   InspectionItem[]
  quarantines       MaterialQuarantine[]

  @@index([grnId], map: "grn_items_grn_id_fkey")
  @@index([materialId], map: "grn_items_material_id_fkey")
  @@index([storageLocationId], map: "grn_items_storage_location_id_fkey")
  @@index([unitId], map: "grn_items_unit_id_fkey")
  @@map("grn_items")
}

model MaterialInspection {
  id               String               @id @default(uuid()) @db.Char(36)
  inspectionNumber String               @unique(map: "inspection_number") @map("inspection_number") @db.VarChar(50)
  grnId            String               @map("grn_id") @db.Char(36)
  inspectionDate   DateTime             @map("inspection_date") @db.Date
  inspectorId      String               @map("inspector_id") @db.Char(36)
  status           InspectionStatus     @default(PENDING)
  decision         InspectionDecision?
  remarks          String?              @db.Text
  correctiveAction String?              @map("corrective_action") @db.Text
  createdAt        DateTime             @default(now()) @map("created_at")
  items            InspectionItem[]
  quarantines      MaterialQuarantine[]
  grn              GoodsReceivedNote    @relation(fields: [grnId], references: [id])
  inspector        User                 @relation("Inspector", fields: [inspectorId], references: [id])

  @@index([inspectionDate])
  @@index([grnId], map: "material_inspections_grn_id_fkey")
  @@index([inspectorId], map: "material_inspections_inspector_id_fkey")
  @@map("material_inspections")
}

model InspectionItem {
  id                            String               @id @default(uuid()) @db.Char(36)
  inspectionId                  String               @map("inspection_id") @db.Char(36)
  grnItemId                     String               @map("grn_item_id") @db.Char(36)
  quantityInspected             Decimal?             @map("quantity_inspected") @db.Decimal(18, 3)
  quantityAccepted              Decimal              @default(0.000) @map("quantity_accepted") @db.Decimal(18, 3)
  quantityConditionallyAccepted Decimal              @default(0.000) @map("quantity_conditionally_accepted") @db.Decimal(18, 3)
  quantityQuarantined           Decimal              @default(0.000) @map("quantity_quarantined") @db.Decimal(18, 3)
  quantityRejected              Decimal              @default(0.000) @map("quantity_rejected") @db.Decimal(18, 3)
  specification                 String?              @db.Text
  requiredStandard              String?              @map("required_standard") @db.VarChar(100)
  certificateNumber             String?              @map("certificate_number") @db.VarChar(100)
  testRequired                  Boolean              @default(false) @map("test_required")
  testResult                    String?              @map("test_result") @db.Text
  remarks                       String?              @db.Text
  materialId                    String?              @db.Char(36)
  grnItem                       GrnItem              @relation(fields: [grnItemId], references: [id])
  inspection                    MaterialInspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  material                      Material?            @relation(fields: [materialId], references: [id])
  quarantines                   MaterialQuarantine[]

  @@index([grnItemId], map: "inspection_items_grn_item_id_fkey")
  @@index([inspectionId], map: "inspection_items_inspection_id_fkey")
  @@index([materialId], map: "inspection_items_materialId_fkey")
  @@map("inspection_items")
}

model MaterialQuarantine {
  id               String @id @default(uuid()) @db.Char(36)
  quarantineNumber String @unique(map: "quarantine_number") @map("quarantine_number") @db.VarChar(50)

  projectId        String @map("project_id") @db.Char(36)
  inspectionId     String @map("inspection_id") @db.Char(36)
  inspectionItemId String @map("inspection_item_id") @db.Char(36)
  grnId            String @map("grn_id") @db.Char(36)
  grnItemId        String @map("grn_item_id") @db.Char(36)
  materialId       String @map("material_id") @db.Char(36)

  quantity Decimal @db.Decimal(18, 3)
  unitId   String  @map("unit_id") @db.Char(36)

  reason           String? @db.Text
  correctiveAction String? @map("corrective_action") @db.Text

  status QuarantineStatus @default(QUARANTINED)

  quarantinedAt DateTime  @default(now()) @map("quarantined_at")
  releasedAt    DateTime? @map("released_at")
  returnedAt    DateTime? @map("returned_at")
  scrappedAt    DateTime? @map("scrapped_at")

  createdBy String   @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project        Project            @relation(fields: [projectId], references: [id])
  inspection     MaterialInspection @relation(fields: [inspectionId], references: [id])
  inspectionItem InspectionItem     @relation(fields: [inspectionItemId], references: [id])
  grn            GoodsReceivedNote  @relation(fields: [grnId], references: [id])
  grnItem        GrnItem            @relation(fields: [grnItemId], references: [id])
  material       Material           @relation(fields: [materialId], references: [id])
  unit           Unit               @relation(fields: [unitId], references: [id])
  creator        User               @relation("QuarantineCreatedBy", fields: [createdBy], references: [id])

  dispositions MaterialDisposition[]

  @@index([projectId])
  @@index([inspectionId])
  @@index([inspectionItemId])
  @@index([grnId])
  @@index([grnItemId])
  @@index([materialId])
  @@index([status])
  @@index([createdBy])
  @@map("material_quarantines")
}

model MaterialDisposition {
  id                String @id @default(uuid()) @db.Char(36)
  dispositionNumber String @unique(map: "disposition_number") @map("disposition_number") @db.VarChar(50)

  quarantineId String @map("quarantine_id") @db.Char(36)

  action DispositionAction

  quantity Decimal @db.Decimal(18, 3)

  reason  String? @db.Text
  remarks String? @db.Text

  actionDate DateTime @default(now()) @map("action_date")

  performedBy String @map("performed_by") @db.Char(36)

  createdAt DateTime @default(now()) @map("created_at")

  quarantine MaterialQuarantine @relation(fields: [quarantineId], references: [id], onDelete: Cascade)
  performer  User               @relation("DispositionPerformedBy", fields: [performedBy], references: [id])

  @@index([quarantineId])
  @@index([action])
  @@index([performedBy])
  @@index([actionDate])
  @@map("material_dispositions")
}

model InventoryBalance {
  id                String           @id @default(uuid()) @db.Char(36)
  projectId         String           @map("project_id") @db.Char(36)
  materialId        String           @map("material_id") @db.Char(36)
  warehouseId       String           @map("warehouse_id") @db.Char(36)
  storageLocationId String?          @map("storage_location_id") @db.Char(36)
  physicalQuantity  Decimal          @default(0.000) @map("physical_quantity") @db.Decimal(18, 3)
  reservedQuantity  Decimal          @default(0.000) @map("reserved_quantity") @db.Decimal(18, 3)
  averageUnitCost   Decimal          @default(0.00) @map("average_unit_cost") @db.Decimal(18, 2)
  stockValue        Decimal          @default(0.00) @map("stock_value") @db.Decimal(18, 2)
  updatedAt         DateTime         @updatedAt @map("updated_at")
  material          Material         @relation(fields: [materialId], references: [id])
  project           Project          @relation(fields: [projectId], references: [id])
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id])
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id])

  @@unique([projectId, materialId, warehouseId, storageLocationId], map: "uq_inventory_location")
  @@index([materialId], map: "idx_inventory_material")
  @@index([projectId], map: "idx_inventory_project")
  @@index([storageLocationId], map: "inventory_balances_storage_location_id_fkey")
  @@index([warehouseId], map: "inventory_balances_warehouse_id_fkey")
  @@map("inventory_balances")
}

model InventoryTransaction {
  id                String                   @id @default(uuid()) @db.Char(36)
  transactionNumber String                   @unique(map: "transaction_number") @map("transaction_number") @db.VarChar(50)
  projectId         String                   @map("project_id") @db.Char(36)
  materialId        String                   @map("material_id") @db.Char(36)
  warehouseId       String                   @map("warehouse_id") @db.Char(36)
  storageLocationId String?                  @map("storage_location_id") @db.Char(36)
  transactionType   InventoryTransactionType @map("transaction_type")
  quantity          Decimal                  @db.Decimal(18, 3)
  unitCost          Decimal?                 @map("unit_cost") @db.Decimal(18, 2)
  totalValue        Decimal?                 @map("total_value") @db.Decimal(18, 2)
  referenceType     String?                  @map("reference_type") @db.VarChar(50)
  referenceId       String?                  @map("reference_id") @db.Char(36)
  transactionDate   DateTime                 @default(now()) @map("transaction_date")
  performedBy       String?                  @map("performed_by") @db.Char(36)
  reason            String?                  @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at")
  material          Material                 @relation(fields: [materialId], references: [id])
  performer         User?                    @relation(fields: [performedBy], references: [id])
  project           Project                  @relation(fields: [projectId], references: [id])
  storageLocation   StorageLocation?         @relation(fields: [storageLocationId], references: [id])
  warehouse         Warehouse                @relation(fields: [warehouseId], references: [id])

  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([transactionDate], map: "idx_inventory_transactions_date")
  @@index([materialId], map: "idx_inventory_transactions_material")
  @@index([projectId], map: "idx_inventory_transactions_project")
  @@index([performedBy], map: "inventory_transactions_performed_by_fkey")
  @@index([storageLocationId], map: "inventory_transactions_storage_location_id_fkey")
  @@index([warehouseId], map: "inventory_transactions_warehouse_id_fkey")
  @@map("inventory_transactions")
}

model MaterialIssue {
  id          String                @id @default(uuid()) @db.Char(36)
  issueNumber String                @unique(map: "issue_number") @map("issue_number") @db.VarChar(50)
  projectId   String                @map("project_id") @db.Char(36)
  warehouseId String                @map("warehouse_id") @db.Char(36)
  requestedBy String?               @map("requested_by") @db.Char(36)
  approvedBy  String?               @map("approved_by") @db.Char(36)
  receiverId  String?               @map("receiver_id") @db.Char(36)
  activityId  String?               @map("activity_id") @db.Char(36)
  buildingId  String?               @map("building_id") @db.Char(36)
  zoneId      String?               @map("zone_id") @db.Char(36)
  issueDate   DateTime              @map("issue_date") @db.Date
  status      MaterialIssueStatus   @default(DRAFT)
  purpose     String?               @db.Text
  remarks     String?               @db.Text
  createdAt   DateTime              @default(now()) @map("created_at")
  consumption MaterialConsumption[]
  items       MaterialIssueItem[]
  activity    Activity?             @relation(fields: [activityId], references: [id])
  approver    User?                 @relation("IssueApprovedBy", fields: [approvedBy], references: [id])
  building    Building?             @relation(fields: [buildingId], references: [id])
  project     Project               @relation(fields: [projectId], references: [id])
  receiver    User?                 @relation("IssueReceiver", fields: [receiverId], references: [id])
  requester   User?                 @relation("IssueRequestedBy", fields: [requestedBy], references: [id])
  warehouse   Warehouse             @relation(fields: [warehouseId], references: [id])
  zone        Zone?                 @relation(fields: [zoneId], references: [id])
  returns     MaterialReturn[]

  @@index([status])
  @@index([issueDate])
  @@index([projectId], map: "idx_material_issues_project")
  @@index([activityId], map: "material_issues_activity_id_fkey")
  @@index([approvedBy], map: "material_issues_approved_by_fkey")
  @@index([buildingId], map: "material_issues_building_id_fkey")
  @@index([receiverId], map: "material_issues_receiver_id_fkey")
  @@index([requestedBy], map: "material_issues_requested_by_fkey")
  @@index([warehouseId], map: "material_issues_warehouse_id_fkey")
  @@index([zoneId], map: "material_issues_zone_id_fkey")
  @@map("material_issues")
}

model MaterialIssueItem {
  id                String           @id @default(uuid()) @db.Char(36)
  issueId           String           @map("issue_id") @db.Char(36)
  materialId        String           @map("material_id") @db.Char(36)
  approvedQuantity  Decimal          @map("approved_quantity") @db.Decimal(18, 3)
  issuedQuantity    Decimal          @map("issued_quantity") @db.Decimal(18, 3)
  unitCost          Decimal?         @map("unit_cost") @db.Decimal(18, 2)
  storageLocationId String?          @map("storage_location_id") @db.Char(36)
  issue             MaterialIssue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  material          Material         @relation(fields: [materialId], references: [id])
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id])

  @@index([issueId], map: "material_issue_items_issue_id_fkey")
  @@index([materialId], map: "material_issue_items_material_id_fkey")
  @@index([storageLocationId], map: "material_issue_items_storage_location_id_fkey")
  @@map("material_issue_items")
}

model MaterialReturn {
  id              String               @id @default(uuid()) @db.Char(36)
  returnNumber    String               @unique(map: "return_number") @map("return_number") @db.VarChar(50)
  projectId       String               @map("project_id") @db.Char(36)
  originalIssueId String?              @map("original_issue_id") @db.Char(36)
  returnedBy      String?              @map("returned_by") @db.Char(36)
  receivedBy      String?              @map("received_by") @db.Char(36)
  returnDate      DateTime             @map("return_date") @db.Date
  reason          String?              @db.Text
  status          MaterialReturnStatus @default(PENDING)
  remarks         String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")
  items           MaterialReturnItem[]
  originalIssue   MaterialIssue?       @relation(fields: [originalIssueId], references: [id])
  project         Project              @relation(fields: [projectId], references: [id])
  receiver        User?                @relation("ReturnReceivedBy", fields: [receivedBy], references: [id])
  returner        User?                @relation("ReturnReturnedBy", fields: [returnedBy], references: [id])

  @@index([returnDate])
  @@index([originalIssueId], map: "material_returns_original_issue_id_fkey")
  @@index([projectId], map: "material_returns_project_id_fkey")
  @@index([receivedBy], map: "material_returns_received_by_fkey")
  @@index([returnedBy], map: "material_returns_returned_by_fkey")
  @@map("material_returns")
}

model MaterialReturnItem {
  id               String                   @id @default(uuid()) @db.Char(36)
  returnId         String                   @map("return_id") @db.Char(36)
  materialId       String                   @map("material_id") @db.Char(36)
  issuedQuantity   Decimal?                 @map("issued_quantity") @db.Decimal(18, 3)
  consumedQuantity Decimal?                 @map("consumed_quantity") @db.Decimal(18, 3)
  returnedQuantity Decimal                  @map("returned_quantity") @db.Decimal(18, 3)
  damagedQuantity  Decimal                  @default(0.000) @map("damaged_quantity") @db.Decimal(18, 3)
  acceptedQuantity Decimal                  @default(0.000) @map("accepted_quantity") @db.Decimal(18, 3)
  rejectedQuantity Decimal                  @default(0.000) @map("rejected_quantity") @db.Decimal(18, 3)
  conditionStatus  MaterialConditionStatus? @map("condition_status")
  remarks          String?                  @db.Text
  material         Material                 @relation(fields: [materialId], references: [id])
  return           MaterialReturn           @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([materialId], map: "material_return_items_material_id_fkey")
  @@index([returnId], map: "material_return_items_return_id_fkey")
  @@map("material_return_items")
}

model StockCount {
  id          String            @id @default(uuid()) @db.Char(36)
  countNumber String            @unique(map: "count_number") @map("count_number") @db.VarChar(50)
  projectId   String            @map("project_id") @db.Char(36)
  warehouseId String?           @map("warehouse_id") @db.Char(36)
  countDate   DateTime          @map("count_date") @db.Date
  countedBy   String?           @map("counted_by") @db.Char(36)
  verifiedBy  String?           @map("verified_by") @db.Char(36)
  status      StockCountStatus  @default(DRAFT)
  remarks     String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  items       StockCountItem[]
  adjustments StockAdjustment[]
  counter     User?             @relation("StockCountedBy", fields: [countedBy], references: [id])
  project     Project           @relation(fields: [projectId], references: [id])
  verifier    User?             @relation("StockVerifiedBy", fields: [verifiedBy], references: [id])
  warehouse   Warehouse?        @relation(fields: [warehouseId], references: [id])

  @@index([countDate])
  @@index([countedBy], map: "stock_counts_counted_by_fkey")
  @@index([projectId], map: "stock_counts_project_id_fkey")
  @@index([verifiedBy], map: "stock_counts_verified_by_fkey")
  @@index([warehouseId], map: "stock_counts_warehouse_id_fkey")
  @@map("stock_counts")
}

model StockCountItem {
  id                String           @id @default(uuid()) @db.Char(36)
  stockCountId      String           @map("stock_count_id") @db.Char(36)
  materialId        String           @map("material_id") @db.Char(36)
  storageLocationId String?          @map("storage_location_id") @db.Char(36)
  systemQuantity    Decimal          @map("system_quantity") @db.Decimal(18, 3)
  physicalQuantity  Decimal          @map("physical_quantity") @db.Decimal(18, 3)
  reason            String?          @db.Text
  material          Material         @relation(fields: [materialId], references: [id])
  stockCount        StockCount       @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id])

  @@index([materialId], map: "stock_count_items_material_id_fkey")
  @@index([stockCountId], map: "stock_count_items_stock_count_id_fkey")
  @@index([storageLocationId], map: "stock_count_items_storage_location_id_fkey")
  @@map("stock_count_items")
}

model StockAdjustment {
  id               String                @id @default(uuid()) @db.Char(36)
  adjustmentNumber String                @unique(map: "adjustment_number") @map("adjustment_number") @db.VarChar(50)
  projectId        String                @map("project_id") @db.Char(36)
  warehouseId      String                @map("warehouse_id") @db.Char(36)
  stockCountId     String?               @map("stock_count_id") @db.Char(36)
  requestedBy      String?               @map("requested_by") @db.Char(36)
  approvedBy       String?               @map("approved_by") @db.Char(36)
  adjustmentDate   DateTime              @map("adjustment_date") @db.Date
  status           StockAdjustmentStatus @default(PENDING)
  reason           String                @db.Text
  createdAt        DateTime              @default(now()) @map("created_at")

  items StockAdjustmentItem[]

  approver   User?       @relation("AdjustmentApprovedBy", fields: [approvedBy], references: [id])
  requester  User?       @relation("AdjustmentRequestedBy", fields: [requestedBy], references: [id])
  stockCount StockCount? @relation(fields: [stockCountId], references: [id])

  project   Project   @relation(fields: [projectId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([status])
  @@index([approvedBy], map: "stock_adjustments_approved_by_fkey")
  @@index([projectId], map: "stock_adjustments_project_id_fkey")
  @@index([requestedBy], map: "stock_adjustments_requested_by_fkey")
  @@index([warehouseId], map: "stock_adjustments_warehouse_id_fkey")
  @@index([stockCountId])
  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id                String  @id @default(uuid()) @db.Char(36)
  adjustmentId      String  @map("adjustment_id") @db.Char(36)
  materialId        String  @map("material_id") @db.Char(36)
  storageLocationId String? @map("storage_location_id") @db.Char(36)

  systemQuantity   Decimal @map("system_quantity") @db.Decimal(18, 3)
  physicalQuantity Decimal @map("physical_quantity") @db.Decimal(18, 3)
  varianceQuantity Decimal @map("variance_quantity") @db.Decimal(18, 3)

  reason String? @db.Text

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  material   Material        @relation(fields: [materialId], references: [id])

  @@index([adjustmentId])
  @@index([materialId])
  @@map("stock_adjustment_items")
}

model MaterialConsumption {
  id               String         @id @default(uuid()) @db.Char(36)
  projectId        String         @map("project_id") @db.Char(36)
  materialId       String         @map("material_id") @db.Char(36)
  activityId       String?        @map("activity_id") @db.Char(36)
  buildingId       String?        @map("building_id") @db.Char(36)
  zoneId           String?        @map("zone_id") @db.Char(36)
  issueId          String?        @map("issue_id") @db.Char(36)
  consumptionDate  DateTime       @map("consumption_date") @db.Date
  plannedQuantity  Decimal?       @map("planned_quantity") @db.Decimal(18, 3)
  issuedQuantity   Decimal?       @map("issued_quantity") @db.Decimal(18, 3)
  returnedQuantity Decimal?       @map("returned_quantity") @db.Decimal(18, 3)
  consumedQuantity Decimal?       @map("consumed_quantity") @db.Decimal(18, 3)
  remarks          String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at")
  activity         Activity?      @relation(fields: [activityId], references: [id])
  building         Building?      @relation(fields: [buildingId], references: [id])
  issue            MaterialIssue? @relation(fields: [issueId], references: [id])
  material         Material       @relation(fields: [materialId], references: [id])
  project          Project        @relation(fields: [projectId], references: [id])
  zone             Zone?          @relation(fields: [zoneId], references: [id])

  @@index([consumptionDate])
  @@index([materialId], map: "idx_material_consumption_material")
  @@index([activityId], map: "material_consumption_activity_id_fkey")
  @@index([buildingId], map: "material_consumption_building_id_fkey")
  @@index([issueId], map: "material_consumption_issue_id_fkey")
  @@index([projectId], map: "material_consumption_project_id_fkey")
  @@index([zoneId], map: "material_consumption_zone_id_fkey")
  @@map("material_consumption")
}

model MaterialWastage {
  id          String                @id @default(uuid()) @db.Char(36)
  wastageNumber   String            @unique(map: "wastage_number") @map("wastage_number") @db.VarChar(50)
  projectId   String                @map("project_id") @db.Char(36)
  materialId  String                @map("material_id") @db.Char(36)
  activityId  String?               @map("activity_id") @db.Char(36)
  buildingId  String?               @map("building_id") @db.Char(36)
  wastageDate DateTime              @map("wastage_date") @db.Date
  quantity    Decimal               @db.Decimal(18, 3)
  reason      String                @db.Text
  reportedBy  String?               @map("reported_by") @db.Char(36)
  approvedBy  String?               @map("approved_by") @db.Char(36)
  status      StockAdjustmentStatus @default(PENDING)
  createdAt   DateTime              @default(now()) @map("created_at")
  activity    Activity?             @relation(fields: [activityId], references: [id])
  approver    User?                 @relation("WastageApprovedBy", fields: [approvedBy], references: [id])
  building    Building?             @relation(fields: [buildingId], references: [id])
  material    Material              @relation(fields: [materialId], references: [id])
  project     Project               @relation(fields: [projectId], references: [id])
  reporter    User?                 @relation("WastageReportedBy", fields: [reportedBy], references: [id])

  @@index([wastageDate])
  @@index([materialId], map: "idx_material_wastage_material")
  @@index([activityId], map: "material_wastage_activity_id_fkey")
  @@index([approvedBy], map: "material_wastage_approved_by_fkey")
  @@index([buildingId], map: "material_wastage_building_id_fkey")
  @@index([projectId], map: "material_wastage_project_id_fkey")
  @@index([reportedBy], map: "material_wastage_reported_by_fkey")
  @@map("material_wastage")
}

model Document {
  id            String   @id @default(uuid()) @db.Char(36)
  projectId     String?  @map("project_id") @db.Char(36)
  documentType  String   @map("document_type") @db.VarChar(50)
  fileName      String   @map("file_name") @db.VarChar(255)
  fileUrl       String   @map("file_url") @db.Text
  mimeType      String?  @map("mime_type") @db.VarChar(100)
  fileSize      BigInt?  @map("file_size")
  uploadedBy    String?  @map("uploaded_by") @db.Char(36)
  referenceType String?  @map("reference_type") @db.VarChar(50)
  referenceId   String?  @map("reference_id") @db.Char(36)
  createdAt     DateTime @default(now()) @map("created_at")
  project       Project? @relation(fields: [projectId], references: [id])
  uploader      User?    @relation(fields: [uploadedBy], references: [id])

  @@index([referenceType, referenceId])
  @@index([projectId], map: "documents_project_id_fkey")
  @@index([uploadedBy], map: "documents_uploaded_by_fkey")
  @@map("documents")
}

model Notification {
  id               String           @id @default(uuid()) @db.Char(36)
  userId           String           @map("user_id") @db.Char(36)
  title            String           @db.VarChar(255)
  message          String           @db.Text
  notificationType NotificationType @default(INFO) @map("notification_type")
  referenceType    String?          @map("reference_type") @db.VarChar(50)
  referenceId      String?          @map("reference_id") @db.Char(36)
  isRead           Boolean          @default(false) @map("is_read")
  createdAt        DateTime         @default(now()) @map("created_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, isRead], map: "idx_notifications_user_read")
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Char(36)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([userId], map: "idx_audit_user")
  @@map("audit_logs")
}

